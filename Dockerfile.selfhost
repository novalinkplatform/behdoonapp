FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# خالی یعنی درخواست‌های /api/... به‌صورت نسبی و از همان دامنه بروند (پراکسی توسط Caddy انجام می‌شود).
ENV VITE_API_BASE_URL=""
# خریدارهای نسخه‌ی خوداستقرار لزوماً مخاطب فارسی‌زبان ندارند؛ زبان پیش‌فرض روی انگلیسی است (کاربر همچنان
# می‌تواند با دکمه‌ی تغییر زبان به فارسی برود — این فقط پیش‌فرض اولیه را عوض می‌کند).
ENV VITE_DEFAULT_LANG="en"
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.selfhost.conf /etc/nginx/conf.d/default.conf
# با شروع کانتینر، nginx خودش هر اسکریپت اجرایی این پوشه را قبل از بالا آمدن سرور اجرا می‌کند —
# همین‌جا SITE_DOMAIN واقعی خریدار جای‌گیر __SITE_ORIGIN__ باقی‌مانده در HTML/robots/sitemap را پر می‌کند.
COPY docker-entrypoint.d/10-inject-site-origin.sh /docker-entrypoint.d/10-inject-site-origin.sh
RUN chmod +x /docker-entrypoint.d/10-inject-site-origin.sh
EXPOSE 80
