# ==============================================================================
# Behdoon Environment Configuration Template
# Copy this file to .env on your server and set strong values
# ==============================================================================

# 1. Server & Host Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SITE_ORIGIN=https://behdoon.ir

# 2. Cryptographic Security & Session Secret (Generate a 64-char random string)
SESSION_SECRET=bhd_sec_prod_9f82d1c4b7a6e534918273645019283746501928374650192837465019283746

# 3. Super Admin Initial Credentials
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@Behdoon2026!

# 4. SMS Provider Gateway (Melipayamak / Kavenegar)
SMS_USERNAME=your_sms_username
SMS_PASSWORD=your_sms_password
SMS_BODY_ID=your_sms_body_id

# 5. Cloudflare Workers & D1 (Optional - if using Cloudflare deployment)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=465d5b09f92a17a6ed4e92d33c98bc17
D1_DATABASE_NAME=behdoon_db
D1_DATABASE_ID=553f417c-4154-48c5-8bf7-04920092ac05
